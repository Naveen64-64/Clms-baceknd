# CLMS Backend Environment Configuration Template
# Duplicate this file as '.env' and provide your actual secrets.

PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/kiet_library_db?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/kiet_library_test_db

# Authentication Secrets (Generate secure random 64-character hex strings)
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_key_here
REFRESH_TOKEN_EXPIRES_IN=30d

# Initial System Administration Seed Credentials (Optional)
ADMIN_EMAIL=admin@kiet.edu
ADMIN_PASSWORD=your_secure_admin_password_here

# Allowed CORS Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Library Assistant (Groq Cloud API)
GROQ_API_KEY=groq api key here
GROQ_MODEL=llama-3.3-70b-versatile
